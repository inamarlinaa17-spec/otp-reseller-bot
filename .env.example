BOT_TOKEN=
ADMIN_ID=
ADMIN_USERNAME=
DATABASE_URL=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

FIVESIM_API_KEY=

# Public Telegram promo channel shown in the user info menu
# Examples: @YourChannel | YourChannel | https://t.me/YourChannel
PROMO_CHANNEL=

# Optional traffic notification channel for automatic OTP notifications
# Example: @TRAFIC_OTP_AZHURA_ID or -1001234567890
TRAFFIC_CHANNEL=@Tracif_NokosAzhura

# Optional separate bot token for the traffic notifier. Leave empty to use BOT_TOKEN.
TRAFFIC_BOT_TOKEN=

# Kurs USD/IDR diambil otomatis saat bot startup.
# Tidak perlu menambahkan KURS_DOLAR di Railway Variables.

# Reseller margin
PROFIT_PERCENT=7

RUMAHOTP_API_KEY=

# PremOTP API v1 (Server 3 + QRIS otomatis)
PREMOTP_API_KEY=
PREMOTP_WEBHOOK_SECRET=
PREMOTP_BASE_URL=https://premotp.biz.id/api/v1

# Server 4 — OTP global (API key dari akun Server 4)
GRIZZLYSMS_API_KEY=

# Reseller / whitelabel: minimum penarikan saldo margin (Rupiah)
RESELLER_MIN_WD=5000

# ---------------------------------------------------------
# SMM PANEL + APK PREMIUM AZHURA (backend SIMURU)
# Isi di service BOT dan service WEB (Railway)
# Nama SIMURU TIDAK ditampilkan ke user — branding: APK PREMIUM AZHURA
# Margin APK PREMIUM khusus 10% (hardcoded di apk_premium.py)
# ---------------------------------------------------------
SIMURU_API_KEY=
# Opsional: override base URL (default https://simuru.com/api)
# SIMURU_BASE_URL=https://simuru.com/api
# ID channel Telegram "TRAFIC LIVE" (contoh -1001234567890 atau @namachannel).
# Bot harus menjadi admin channel. Jika kosong, memakai TRAFFIC_CHANNEL.
TRAFIC_LIVE_CHANNEL_ID=

# URL publik Azhura Web (https) — wajib agar tombol SMM PANEL & APK PREMIUM
# di bot Telegram langsung membuka mini app (WebApp).
# Contoh: https://azhura-web.up.railway.app
AZHURA_WEB_URL=
# Opsional: set 0 untuk paksa menu di dalam bot (bukan mini app)
# SMM_MINIAPP=1
# APK_MINIAPP=1
